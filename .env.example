# 필수
DATABASE_URL=postgres://ggai:ggai@postgres:5432/ggai
APP_BASE_URL=http://localhost:3000
# APP_CRYPTO_KEY: base64 32바이트. '=' 뒤에 키만 적는다 (같은 줄에 주석·따옴표 금지 — Docker Compose가 값으로 읽는다)
#   PowerShell: [Convert]::ToBase64String((1..32 | ForEach-Object { [byte](Get-Random -Maximum 256) }))
#   Node:       node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
APP_CRYPTO_KEY=
APP_CRYPTO_KEY_ID=k1
# LLM: anthropic | fake(LLM 없이 로컬 실행). 키를 넣기 전까지는 fake 로 둔다
LLM_PROVIDER=fake
# ANTHROPIC_API_KEY: console.anthropic.com → API Keys. 워커만 사용. LLM_PROVIDER=fake 면 비워도 됨
ANTHROPIC_API_KEY=
LLM_CHUNK_MODEL=claude-sonnet-5-5
# 전사가 LLM_CHUNK_LARGE_TOKENS(기본 100만)를 넘으면 청크 읽기를 이 모델로 (비용 1/20)
LLM_CHUNK_MODEL_LARGE=claude-haiku-5-5
LLM_SYNTHESIS_MODEL=claude-opus-5-5
LLM_FALLBACK_MODEL=claude-opus-4-8
LLM_MAX_COST_USD=5
# 페르소나·기능
PERSONA_NAME=까비서
DEFAULT_TONE=CASUAL
SCORES_ENABLED=true
# 한도
UPLOAD_MAX_BYTES=52428800
UPLOAD_MIN_MESSAGES=30
RAW_RETENTION_DAYS=7
WORKER_CONCURRENCY=2
LIMIT_UPLOADS_PER_IP_PER_HOUR=10
LIMIT_REPORTS_PER_OWNER_PER_DAY=10
IP_HASH_SALT=change-me

# 고급 한도 (기본값 = src/server/config.ts). 보통은 비워 둔다
# UPLOAD_MAX_MESSAGES=300000
# UPLOAD_MAX_PARTICIPANTS=60
# LLM_SINGLE_PASS_MAX_TOKENS=150000   # 이하이면 전사를 한 번에, 넘으면 월별 청크
# LLM_CHUNK_MAX_TOKENS=60000
# LLM_MAX_TOTAL_TOKENS=1500000        # 넘으면 샘플링(커버리지 < 100%)
# LLM_CALL_TIMEOUT_MS=600000
# WORKER_CHUNK_CONCURRENCY=3
# WORKER_STALE_MINUTES=10             # 하트비트(30초 주기) 끊긴 RUNNING 보고서 재큐잉 기준
# WORKER_MAX_ATTEMPTS=3
# WORKER_PIPELINE_TIMEOUT_MINUTES=25
# STAGE_RESULT_RETENTION_HOURS=24     # SUCCEEDED 보고서의 체크포인트 보관
# LLM_JSON_MODE_STAGES=SYNTHESIS       # 구조화 출력 대신 JSON 모드로 호출할 단계 (CHUNK,SYNTHESIS,REPAIR 중)
