# 필수
DATABASE_URL=postgres://ggai:ggai@postgres:5432/ggai
APP_BASE_URL=http://localhost:3000
APP_CRYPTO_KEY=   # base64 32바이트: node -e 'console.log(require("crypto").randomBytes(32).toString("base64"))'
APP_CRYPTO_KEY_ID=k1
# LLM: anthropic(기본) | fake(LLM 없이 로컬 실행)
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
LLM_CHUNK_MODEL=claude-sonnet-5-5
LLM_SYNTHESIS_MODEL=claude-opus-5-5
LLM_FALLBACK_MODEL=claude-opus-4-8
LLM_MAX_COST_USD=5
# 페르소나·기능
PERSONA_NAME=까비서
DEFAULT_TONE=CASUAL
SCORES_ENABLED=true
# 한도
UPLOAD_MAX_BYTES=52428800
UPLOAD_MIN_MESSAGES=30
RAW_RETENTION_DAYS=7
WORKER_CONCURRENCY=2
LIMIT_UPLOADS_PER_IP_PER_HOUR=10
LIMIT_REPORTS_PER_OWNER_PER_DAY=10
IP_HASH_SALT=change-me

# 고급 한도 (기본값 = src/server/config.ts). 보통은 비워 둔다
# UPLOAD_MAX_MESSAGES=300000
# UPLOAD_MAX_PARTICIPANTS=60
# LLM_SINGLE_PASS_MAX_TOKENS=150000   # 이하이면 전사를 한 번에, 넘으면 월별 청크
# LLM_CHUNK_MAX_TOKENS=60000
# LLM_MAX_TOTAL_TOKENS=1500000        # 넘으면 샘플링(커버리지 < 100%)
# LLM_CALL_TIMEOUT_MS=600000
# WORKER_CHUNK_CONCURRENCY=3
# WORKER_STALE_MINUTES=3              # 하트비트 끊긴 RUNNING 보고서 재큐잉 기준
# WORKER_MAX_ATTEMPTS=3
# WORKER_PIPELINE_TIMEOUT_MINUTES=25
# STAGE_RESULT_RETENTION_HOURS=24     # SUCCEEDED 보고서의 체크포인트 보관
