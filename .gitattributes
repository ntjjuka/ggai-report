# Windows(core.autocrlf=true)에서 받아도 컨테이너·bash가 읽는 파일은 LF 유지
* text=auto
*.sh text eol=lf
Dockerfile text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.sql text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.mjs text eol=lf
*.cjs text eol=lf
*.json text eol=lf
*.md text eol=lf
.env.example text eol=lf
.env.test text eol=lf
.dockerignore text eol=lf
.gitignore text eol=lf
*.png binary
*.woff2 binary
*.woff binary
*.zip binary
